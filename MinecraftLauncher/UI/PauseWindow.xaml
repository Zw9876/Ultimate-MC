<Window x:Class="MinecraftLauncher.UI.PauseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pause everyone"
        Height="470" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pause everyone" Style="{StaticResource TabTitle}"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Margin="0,0,0,14"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Every game on the network closes within a second or two — the normal way, as if its X were clicked, so worlds are saved and servers left cleanly. There is no countdown and nobody can decline. Nobody can start Minecraft again until this lifts."/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FOR HOW LONG" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="DurationCombo" Height="30" Margin="0,2,0,0"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="A timed pause lifts itself, so forgetting about it cannot strand anybody. You can let everyone back on at any point with the same button."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="REASON" Style="{StaticResource SectionLabel}"/>
                <TextBlock Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Shown to everyone word for word, both as their game closes and if they try to play. Worth a line — otherwise it looks like something broke."/>

                <TextBox Grid.Row="2" x:Name="ReasonBox" MinHeight="48"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="6,5,0,0"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="3" x:Name="ServingNote" Margin="0,12,0,0"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="PauseButton" Content="PAUSE EVERYONE NOW" Width="210" Height="36"
                    Margin="0,0,8,0" IsDefault="True"
                    Click="Pause_Click" Style="{StaticResource AccentButton}"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="110" Height="36"
                    IsCancel="True" Click="Cancel_Click" Style="{StaticResource PlainButton}"/>
        </StackPanel>
    </Grid>
</Window>
