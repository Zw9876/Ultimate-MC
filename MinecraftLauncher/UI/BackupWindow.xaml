<Window x:Class="MinecraftLauncher.UI.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Back up worlds"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Back up worlds" Style="{StaticResource TabTitle}"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" x:Name="IntroLabel" Margin="0,0,0,14"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <!-- ══ what there is to back up ══ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="WORLD" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="WorldCombo" Height="30"
                          SelectionChanged="World_Changed"/>
                <TextBlock x:Name="WorldDetail" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══ what is already kept ══ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="2">
            <ListView x:Name="BackupsList" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Taken" Width="160"
                                        DisplayMemberBinding="{Binding WhenText}"/>
                        <GridViewColumn Header="Size" Width="110"
                                        DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="File" Width="520"
                                        DisplayMemberBinding="{Binding Name}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusLabel" Margin="0,12,0,0"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="BackupButton" Content="BACK UP NOW" Width="170" Height="36"
                    Margin="0,0,8,0" Click="BackUp_Click" Style="{StaticResource AccentButton}"/>
            <Button x:Name="FolderButton" Content="Open folder" Width="130" Height="36"
                    Margin="0,0,8,0" Click="Folder_Click" Style="{StaticResource PlainButton}"/>
            <Button x:Name="DeleteButton" Content="Delete selected" Width="150" Height="36"
                    Margin="0,0,8,0" Click="Delete_Click" Style="{StaticResource PlainButton}"
                    ToolTip="Deletes the selected backup for good — not to the Recycle Bin, since the point is to get the space back"/>
            <Button x:Name="CloseButton" Content="Close" Width="100" Height="36"
                    Click="Close_Click" Style="{StaticResource PlainButton}"/>
        </StackPanel>
    </Grid>
</Window>
