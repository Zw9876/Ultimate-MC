<Window x:Class="MinecraftLauncher.UI.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crash reports"
        Height="680" Width="1020"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Crash reports" Style="{StaticResource TabTitle}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" x:Name="IntroLabel" Margin="0,0,0,14"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ the reports ══ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="2">
                <ListView x:Name="ReportsList" BorderThickness="0" Background="Transparent"
                          SelectionChanged="Report_Selected">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="When" Width="120"
                                            DisplayMemberBinding="{Binding WhenText}"/>
                            <GridViewColumn Header="What happened" Width="180"
                                            DisplayMemberBinding="{Binding Headline}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- ══ the one selected ══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="IN PLAIN ENGLISH" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="SummaryBox" IsReadOnly="True" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150"
                                 VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="THE WHOLE REPORT"
                                   Style="{StaticResource SectionLabel}" Margin="8,6,0,4"/>

                        <TextBox Grid.Row="1" x:Name="FullBox" IsReadOnly="True" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                 FontFamily="Consolas, Courier New" FontSize="11"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="OpenFolderButton" Content="OPEN FOLDER"
                    Width="130" Height="34" Margin="0,0,8,0" Click="OpenFolder_Click"
                    Style="{StaticResource PlainButton}"
                    ToolTip="The crash-reports folder for this version"/>

            <Button Grid.Column="1" x:Name="CopyButton" Content="COPY REPORT"
                    Width="130" Height="34" Click="Copy_Click"
                    Style="{StaticResource PlainButton}"
                    ToolTip="Copies the whole report to the clipboard, to paste somewhere for help"/>

            <TextBlock Grid.Column="2" x:Name="StatusLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

            <Button Grid.Column="3" x:Name="CloseButton" Content="CLOSE"
                    Width="110" Height="34" Click="Close_Click"
                    Style="{StaticResource PlainButton}"/>
        </Grid>
    </Grid>
</Window>
