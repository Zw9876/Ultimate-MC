<Window x:Class="MinecraftLauncher.UI.ModBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get mods from Modrinth"
        Height="720" Width="1180" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <!-- A category pill, as Modrinth shows under each mod. -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- One result. The whole row is the button, so clicking anywhere selects it. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#242424"/>
                                <Setter TargetName="shell" Property="BorderBrush" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Get mods from Modrinth"
                   Style="{StaticResource TabTitle}" Margin="0,0,0,6"/>

        <!-- The target is stated rather than chosen: the Mods tab already decided
             which folder, version and loader this is for, and a second place to
             set it would be a way to install mods somewhere unexpected. -->
        <TextBlock Grid.Row="1" x:Name="TargetLabel" Margin="0,0,0,14"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="SearchBox" Height="34"
                     Style="{StaticResource FieldBox}" KeyDown="SearchBox_KeyDown"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Leave empty to browse everything that fits this version and loader"/>

            <TextBlock Grid.Column="2" Text="Sort by" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>

            <ComboBox Grid.Column="4" x:Name="SortCombo" Width="150" Height="30"
                      VerticalAlignment="Center" SelectionChanged="Sort_Changed"/>

            <Button Grid.Column="6" x:Name="SearchButton" Content="SEARCH"
                    Width="110" Height="34" Click="Search_Click"
                    Style="{StaticResource PlainButton}"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ══ results ══ -->
            <ScrollViewer Grid.Column="0" x:Name="ResultsScroller"
                          VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <!-- Right margin keeps the cards clear of the scrollbar rather than
                     tucking their edge underneath it. -->
                <StackPanel x:Name="ResultsPanel" Margin="0,0,10,0"/>
            </ScrollViewer>

            <!-- ══ details ══ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock x:Name="DetailsPlaceholder"
                               Text="Pick a mod on the left to see what it is and choose a version."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="20"/>

                    <ScrollViewer x:Name="DetailsScroller" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- The icon is painted as the Border's background so the
                                     rounded corners actually clip it; an Image child
                                     would sit square on top of them. -->
                                <Border Grid.Column="0" x:Name="DetailIconShell"
                                        Width="72" Height="72" CornerRadius="10"
                                        Background="#262626" VerticalAlignment="Top">
                                    <TextBlock x:Name="DetailIconLetter" FontSize="30"
                                               FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailAuthor" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="DetailStats" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="DetailDescription" Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock x:Name="DetailTags" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="VERSION" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="VersionCombo" Height="30" Margin="0,0,0,6"/>
                            <TextBlock x:Name="VersionNote" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <Button x:Name="DownloadButton" Content="DOWNLOAD" Height="38"
                                    IsEnabled="False" Click="Download_Click"
                                    Style="{StaticResource AccentButton}" Margin="0,0,0,8"/>

                            <Button x:Name="OpenPageButton" Content="Open on Modrinth" Height="32"
                                    Click="OpenPage_Click" Style="{StaticResource PlainButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="MoreButton" Content="SHOW MORE"
                    Width="130" Height="34" IsEnabled="False" Click="More_Click"
                    Style="{StaticResource PlainButton}"/>

            <TextBlock Grid.Column="2" x:Name="StatusLabel" VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>

            <Button Grid.Column="4" x:Name="CloseButton" Content="CLOSE"
                    Width="110" Height="34" Click="Close_Click"
                    Style="{StaticResource PlainButton}"/>
        </Grid>
    </Grid>
</Window>
