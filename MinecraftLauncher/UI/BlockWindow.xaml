<Window x:Class="MinecraftLauncher.UI.BlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turn playing off"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Turn playing off" Style="{StaticResource TabTitle}"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Margin="0,0,0,14"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Their launcher will refuse to start the game and will tell them why. They can still open the launcher, read the reason and update it."/>

        <!-- == who == -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="WHICH COMPUTER" Style="{StaticResource SectionLabel}"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,2,0,10"
                           Text="Filled in from the fleet list. You can type a computer name by hand for a machine that has never checked in. Matching is on the name OR the Windows identifier, so renaming the computer does not get round it."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="COMPUTER NAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MachineBox" Height="30" Padding="6,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PLAYING AS" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameBox" Height="30" Padding="6,5,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="IdentityNote" Foreground="{StaticResource MutedBrush}"
                           FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- == for how long == -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FOR HOW LONG" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="DurationCombo" Height="30" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- == why == -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="REASON" Style="{StaticResource SectionLabel}"/>
                <TextBlock Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Shown to them word for word. Worth filling in — somebody who is told why is far less likely to go looking for a way round it."/>

                <TextBox Grid.Row="2" x:Name="ReasonBox" MinHeight="54"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="6,5,0,0"
                         VerticalScrollBarVisibility="Auto"/>

                <CheckBox Grid.Row="3" x:Name="ServerBanCheck" Margin="0,12,0,0"
                          Foreground="{StaticResource TextBrush}"
                          Content="Also ban them on the running server (ban-ip and the username)"
                          ToolTip="This is the part that cannot be bypassed, because the server enforces it rather than their launcher"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="BlockButton" Content="TURN PLAYING OFF" Width="190" Height="36"
                    Margin="0,0,8,0" Click="Block_Click" Style="{StaticResource AccentButton}"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="110" Height="36"
                    Click="Cancel_Click" Style="{StaticResource PlainButton}"/>
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
