<Window x:Class="MinecraftLauncher.UI.LoaderUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Fabric loader"
        Height="620" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Update Fabric loader"
                   Style="{StaticResource TabTitle}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" x:Name="CurrentLabel" Margin="0,0,0,12"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <!-- ══ what is being updated ══
             A client and a server keep their loader in completely different places,
             so everything below depends on this choice. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="WHAT TO UPDATE" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="ClientRadio" Content="Client" IsChecked="True"
                                 GroupName="Target" Margin="0,0,24,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"
                                 Checked="Target_Changed"/>
                    <RadioButton x:Name="ServerRadio" Content="Server"
                                 GroupName="Target" VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"
                                 Checked="Target_Changed"/>
                    <TextBlock x:Name="TargetNote" Margin="24,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ online ══ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FROM THE INTERNET" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="OnlineNote" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="For a machine that can reach fabricmc.net. Only the loader is downloaded — the game, worlds and mods are untouched."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="OnlineVersionCombo" Height="30"/>

                    <Button Grid.Column="2" x:Name="RefreshButton" Content="FIND VERSIONS"
                            Width="140" Height="30" Click="Refresh_Click"
                            Style="{StaticResource PlainButton}"/>

                    <Button Grid.Column="4" x:Name="InstallOnlineButton" Content="INSTALL"
                            Width="120" Height="30" IsEnabled="False" Click="InstallOnline_Click"
                            Style="{StaticResource AccentButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ offline ══ -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FROM SUPPLIED FILES" Style="{StaticResource SectionLabel}"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="For a machine with no internet. On a computer that does have it, use MAKE A PACK below, copy the file across, then open it here."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="ImportButton" Content="OPEN A PACK…"
                            Width="150" Height="30" Click="Import_Click"
                            Style="{StaticResource AccentButton}"/>

                    <Button Grid.Column="2" x:Name="ExportButton" Content="MAKE A PACK…"
                            Width="150" Height="30" Click="Export_Click"
                            Style="{StaticResource PlainButton}"
                            ToolTip="Packages a loader already installed here, to carry to the offline machines"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="2">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent"
                     BorderThickness="0" Foreground="{StaticResource TextBrush}"
                     FontFamily="Consolas, Courier New" FontSize="11"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusLabel" VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>

            <Button Grid.Column="1" x:Name="CloseButton" Content="CLOSE"
                    Width="110" Height="34" Click="Close_Click"
                    Style="{StaticResource PlainButton}"/>
        </Grid>
    </Grid>
</Window>
